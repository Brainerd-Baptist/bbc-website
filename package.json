{
  "name": "bbc-website",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:classes": "node scripts/verify-classes.mjs",
    "verify": "tsc --noEmit && npm run verify:classes && npm run verify:contrast",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint:baseline": "eslint --format json | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const n=JSON.parse(s).reduce((a,f)=>a+f.errorCount,0);console.log('eslint errors:',n);})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@portabletext/react": "^3.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sanity/image-url": "^1.0.2",
    "@sanity/vision": "^3.66.1",
    "@tiptap/extension-bullet-list": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-list-item": "^3.31.3",
    "@tiptap/extension-strike": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "framer-motion": "^13.4.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "next-sanity": "^9.8.0",
    "next-themes": "^0.4.6",
    "plyr": "^3.8.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "sanity": "^3.66.1",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
