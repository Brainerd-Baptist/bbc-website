    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint:css": "stylelint \"app/**/*.css\"",
    "ratchet": "node scripts/ratchet.mjs",
    "ratchet:update": "node scripts/ratchet.mjs --update",
    "verify:identity": "node scripts/verify-identity.mjs",
    "lint:color": "node scripts/lint-color.mjs",
    "lint:spacing": "node scripts/lint-spacing.mjs"
  },
