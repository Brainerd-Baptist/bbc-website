# YouTube Data API v3
# Get a key at: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
# Free quota: 10,000 units/day (each page load uses ~3 units, cached for 6h)
YOUTUBE_API_KEY=your_key_here

# Sanity CMS
# Project ID and dataset are public — no secret needed for read-only queries
NEXT_PUBLIC_SANITY_PROJECT_ID=3l0knw74
NEXT_PUBLIC_SANITY_DATASET=production
